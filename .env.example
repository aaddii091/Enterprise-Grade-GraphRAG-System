# Copy to .env and adjust if your ports or credentials differ.

OLLAMA_BASE_URL=http://localhost:11434
VISION_MODEL=qwen2.5vl:3b
TEXT_MODEL=llama3.1

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=graphrag_chunks

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384

CHUNK_SIZE=768
CHUNK_OVERLAP=96
NUM_CTX=8192
VISION_NUM_CTX=2048
TOP_K=3

# Rasterisation DPI for cropped charts/tables. Higher = better vision accuracy,
# more tokens, more RAM. 150 is the sweet spot on 16 GB.
CROP_DPI=150

# Word-separation sensitivity. Lower if words fuse together in extracted text.
X_TOLERANCE=1.5
